    "def signal_SMA(prix, num):\n",
    "    SMA_num=prix.rolling(num).mean()\n",
    "    signal_brut=np.where(prix>SMA_num,1,np.where(prix<SMA_num,-1,0))\n",
    "    signal_brut = pd.Series(signal_brut, index=SMA_num.index)\n",
    "    signal_sma=signal_brut.shift(1)\n",
    "    return signal_sma"
   ]
  },
